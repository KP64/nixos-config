{ den, lib, ... }: {
  den = {
    schema.host.options.facter.reportPath = lib.mkOption {
      readOnly = true;
      type = with lib.types; nullOr path;
      description = "Path to a hardware report generated by nixos-facter";
    };

    hosts =
      let
        hostsDir = ../hosts;

        facterHosts =
          hostsDir
          |> builtins.readDir
          |> builtins.attrNames
          |> builtins.filter (name: !lib.hasPrefix "_" name);
      in
      lib.genAttrs facterHosts (
        name:
        let
          reportPath = lib.path.append hostsDir "${name}/facter.json";
        in
        {
          inherit (lib.importJSON reportPath) system;
          facter = { inherit reportPath; };
        }
      );

    default.includes = [ den.aspects.facter ];
    aspects.facter = { host, ... }: { nixos.hardware = { inherit (host) facter; }; };
  };
}
